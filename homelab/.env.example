# Evolution API — copie para .env e preencha

# Chave global (mestra) — voce inventa, ex: minhasenha123
AUTHENTICATION_API_KEY=

# Chave da instancia WhatsApp — voce inventa, ex: outra-senha-456
AUTHENTICATION_INSTANCE_API_KEY=

# Nome da instancia (nao mudar)
AUTHENTICATION_INSTANCE_NAME=cardapiozap

# Idioma
LANGUAGE=pt-BR

# (Opcional) Dominio proprio para o Cloudflare Tunnel
DOMINIO=
